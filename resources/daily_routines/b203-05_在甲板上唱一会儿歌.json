    "canon_facts": [
      "夏生问亚托莉能否唱那首歌，亚托莉点头并静静吸气",
      "亚托莉起初声音纤细没有自信，后来找回记忆般唱出来",
      "歌声响彻泛着橘色光辉的大海之上",
      "夏生听得入迷并流下眼泪"
    ],
    "character_hook": "亚托莉会为唱歌认真调整呼吸，即便起初没自信也会努力把记忆片段编织成旋律。",
    "adaptation": "将一次唱歌扩展为两小时的音乐练习时间，亚托莉可以反复试唱、回忆歌词、和夏生一起确认旋律；原文只有一次完整演唱，需设定为练习与重复。",
    "editor_note": "她能哼唱熟悉旋律，夏生是听众。唱歌、短歇与听海声自然交替，不输出歌词或预定唱完获赞。",
    "evidence": [
      {
        "line": 4997,
        "id": "vol1/b203.ks.scn/0/dialogue/292",
        "speaker": "夏生",
        "text": "……好想听歌啊"
      },
      {
        "line": 4998,
        "id": "vol1/b203.ks.scn/0/dialogue/293",
        "speaker": "亚托莉",
        "text": "？"
      },
      {
        "line": 4999,
        "id": "vol1/b203.ks.scn/0/dialogue/294",
        "speaker": "夏生",
        "text": "你能给我唱那首歌吗"
      },
      {
        "line": 5000,
        "id": "vol1/b203.ks.scn/0/dialogue/295",
        "speaker": "亚托莉",
        "text": "……"
      },
      {
        "line": 5001,
        "id": "vol1/b203.ks.scn/0/dialogue/296",
        "speaker": "旁白（通常是夏生视角）",
        "text": "亚托莉点头，静静地吸了一口气。"
      },
      {
        "line": 5002,
        "id": "vol1/b203.ks.scn/0/dialogue/297",
        "speaker": "旁白（通常是夏生视角）",
        "text": "一开始发出只是纤细的，没有自信的声音――"
      },
      {
        "line": 5003,
        "id": "vol1/b203.ks.scn/0/dialogue/298",
        "speaker": "旁白（通常是夏生视角）",
        "text": "亚托莉寻找着模糊的记忆，歌唱了起来。"
      },
      {
        "line": 5004,
        "id": "vol1/b203.ks.scn/0/dialogue/299",
        "speaker": "旁白（通常是夏生视角）",
        "text": "捡起埋藏在砂砾之中的记忆片段，编织着旋律。"
      },
      {
        "line": 5006,
        "id": "vol1/b203.ks.scn/0/dialogue/301",
        "speaker": "亚托莉",
        "text": "――――"
      },
      {
        "line": 5007,
        "id": "vol1/b203.ks.scn/0/dialogue/302",
        "speaker": "旁白（通常是夏生视角）",
        "text": "亚托莉歌唱了出来。"
      },
      {
        "line": 5008,
        "id": "vol1/b203.ks.scn/0/dialogue/303",
        "speaker": "旁白（通常是夏生视角）",
        "text": "心怀确信，回忆起一切。"
      },
      {
        "line": 5009,
        "id": "vol1/b203.ks.scn/0/dialogue/304",
        "speaker": "旁白（通常是夏生视角）",
        "text": "如同一副乐器一般，奏出朴素的歌曲，响彻泛着橘色光辉的大海之上。"
      }
    ]
  },
