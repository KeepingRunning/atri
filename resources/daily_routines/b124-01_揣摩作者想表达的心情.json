        "id": "vol1/b124.ks.scn/0/dialogue/76",
        "speaker": "水菜萌",
        "text": "起立，敬礼。老师早上好"
      },
      {
        "line": 3889,
        "id": "vol1/b124.ks.scn/0/dialogue/77",
        "speaker": "凛凛花",
        "text": "早上好"
      },
      {
        "line": 3890,
        "id": "vol1/b124.ks.scn/0/dialogue/78",
        "speaker": "亚托莉",
        "text": "早上好"
