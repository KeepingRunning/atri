# 复制为 config.toml，填写群号、机器人 QQ 号、OneBot token 和模型配置。
# config.toml 包含密钥，已加入 Git 忽略。
[bot]
data_dir = "data"
personal_info = "personal_info.txt"
allowed_groups = []
self_id = ""
queue_size = 32
max_parallel_generations = 4

[onebot]
host = "0.0.0.0"
port = 28080
path = "/onebot/v11/ws"
action_timeout = 15
token = ""

[llm]
# OpenAI 兼容接口地址，包含供应商要求的版本路径（例如 /v1）。
base_url = ""
model = ""
api_key = ""
timeout = 60
max_output_tokens = 512
output_limit_field = "max_tokens"
# DeepSeek 可设 disabled 关闭深度思考；enabled 开启；空字符串不发送此参数。
# DeepSeek 官方：base_url = "https://api.deepseek.com"，model = "deepseek-v4-flash"。
thinking = ""

[context]
# 读取近一小时历史；planner 另外受 max_snapshot_chars 字符预算约束。
history_seconds = 3600

[tools]
# Planner 可先检索历史或看图，再决定是否回复；旧模式在回复阶段查询。
enabled = true
# 最多两轮检索，随后必须决定行动；每批最多四次工具，等待/重规划不重置预算。
max_rounds = 2
max_calls = 4
# 单次工具超时（秒），单次返回的 JSON 字符数上限（不是 token 数）。
timeout = 5
max_result_chars = 8000

[vision]
# 打开后，Planner 可通过 inspect_image 查看当前群近一小时消息中的图片。
# 需要 tools.enabled=true，以及支持 image_url 图片输入的模型。
enabled = false
# 空字符串沿用 llm.model；DeepSeek 官方当前可设 deepseek-flash。
# 沿用 [llm] 的 API 地址和密钥。
model = ""
# 看图工具的总超时，覆盖普通 tools.timeout；包含下载、解码和视觉模型请求。
timeout = 45
download_timeout = 10
max_image_bytes = 8388608
max_pixels = 20000000
max_output_tokens = 768
# 只允许从明确配置的图片服务器下载，不跟随重定向，不读取本地路径。
allowed_hosts = ["multimedia.nt.qq.com.cn", "gchat.qpic.cn", "c2cpicdw.qpic.cn"]

[schedule]
# 上海时间偶数整点，从本地日常库按时段随机选一份；不调用模型。
# enabled 控制清醒时的日程注入；sleep_enabled 独立控制 00:00–08:00 的睡眠拦截。
enabled = true
# 临时夜间测试可设为 false，届时使用“夜晚/不限”日程；测试后改回 true，重启生效。
sleep_enabled = true
timezone = "Asia/Shanghai"
# 路径相对于配置文件目录。
routines_dir = "resources/daily_routines"

[reply]
# planner：按群合并消息 → 动作规划 → 正文生成（新流程）。
# willingness：旧规则评分与模型意愿判断；at_only：旧的仅 @ 回复。
mode = "planner"
# 0 只评估真正 @ 自己或引用自己已发送消息的内容；planner 中非零值作参与偏好传给模型。
frequency = 0.7
names = ["亚托莉", "ATRI", "アトリ"]
# 以下 threshold / continuation_seconds 仅用于旧 willingness 模式。
# 判断模型的意愿分达到此值才生成回复，范围 1–100；分数不是概率。
# 判断失败会重试2次；三次都失败时，用本条消息的规则分对比此阈值。
threshold = 60
cooldown_seconds = 10
continuation_seconds = 90
max_message_age_seconds = 120
# 可选：同一接口上的快速判断模型；空字符串沿用 llm.model。
judgment_model = ""

[planner]
# 连续消息安静两秒后成批；持续发消息最多等八秒、每批最多三十二条。
debounce_seconds = 2
max_batch_seconds = 8
max_batch_messages = 32
# Planner 最多主动等待一次（新消息会提前唤醒）；相关补充最多重建快照一次。
max_wait_seconds = 8
max_waits = 1
max_replans = 1
# 动作参数的输出额度独立于聊天正文；快照上限为字符数，不是 token 数。
# 先裁剪较旧历史；过长消息会标注截断。人设、工具描述、工具结果另受各自限制。
max_output_tokens = 1024
max_snapshot_chars = 32000
# 规划用较低采样温度，减少行动参数漂移；不改变聊天正文的生成参数。
temperature = 0.2

[logging]
# DEBUG 显示各步计算；INFO 只显示主要结果。
level = "DEBUG"
# auto 终端自动彩色；always 即使重定向也保留颜色；never 关闭颜色。
color = "auto"
# 无色轮转日志；路径相对于配置文件目录，空字符串关闭文件日志。
file = "data/logs/atri.log"
max_bytes = 10485760
backup_count = 3
# 收发正文预览字符数，0 隐藏正文。凭据不写入运行日志。
preview_chars = 500

[logging.modules]
# 各分类可独立覆盖级别，例如：
# willingness = "DEBUG"
# storage = "INFO"
# "plugins.weather" = "DEBUG"
